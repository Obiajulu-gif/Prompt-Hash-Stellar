{
  "name": "prompt-hash-stellar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Soroban-based prompt licensing marketplace with XLM payments and wallet-verified unlocks.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Obiajulu-gif/Prompt-Hash-Stellar"
  },
  "scripts": {
    "dev": "node scripts/check-local-setup.mjs --warn-only && vite",
    "start": "vite",
    "build": "node scripts/check-no-mocks.mjs && vite build",
    "prebuild": "node scripts/check-local-setup.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:contract": "cargo test -p prompt-hash",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "node -e \"try { require('fs').existsSync('.husky/') && process.exit(0) } catch(e) {}\" && husky || true",
    "check:setup": "node scripts/check-local-setup.mjs",
    "seed:preview": "node server/scripts/seedPreview.mjs",
    "verify:smoke": "node scripts/smoke-verification.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
